PROJECT_NAME = "OOP Labs"
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/docs"
INPUT = "@CMAKE_CURRENT_SOURCE_DIR@/core/include" "@CMAKE_CURRENT_SOURCE_DIR@/docs/api.md"
RECURSIVE = YES
FILE_PATTERNS = *.hpp *.md
GENERATE_HTML = YES
GENERATE_LATEX = NO
EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
HAVE_DOT = NO
QUIET = YES
WARN_IF_DOC_ERROR = YES
WARN_AS_ERROR = YES
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/api.md"
